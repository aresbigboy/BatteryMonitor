<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:padding="12dp">

    <com.battery.monitor.HistoryChartView
        android:id="@+id/history_chart"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:weightSum="4">

        <Button android:id="@+id/btn_1h" style="@style/TimeRangeBtn" android:text="1小时" android:layout_weight="1" />
        <Button android:id="@+id/btn_6h" style="@style/TimeRangeBtn" android:text="6小时" android:layout_weight="1" />
        <Button android:id="@+id/btn_12h" style="@style/TimeRangeBtn" android:text="12小时" android:layout_weight="1" />
        <Button android:id="@+id/btn_24h" style="@style/TimeRangeBtn" android:text="24小时" android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textColor="#212121"
        android:text="加载中..." />

    <TextView
        android:id="@+id/tv_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

</LinearLayout>
